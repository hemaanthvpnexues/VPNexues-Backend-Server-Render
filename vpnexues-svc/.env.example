# Copy to .env and fill in real values. .env is git-ignored — never commit real secrets.

DB_URL=jdbc:postgresql://localhost:5432/vpnexues_db
DB_USERNAME=vpnexues_app
DB_PASSWORD=changeme

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=changeme

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Inbox for Contact-page form submissions (e.g. jegatheeshwaranvpnexues@gmail.com).
# The backend emails every POST /api/contact-messages submission here.
CONTACT_RECEIVER_EMAIL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# stub = logs OTP instead of sending SMS/WhatsApp (no cost). Swap to a real
# provider (e.g. msg91, whatsapp) later without touching controller/service code.
OTP_PROVIDER=stub

# Only needed when OTP_PROVIDER=whatsapp (see WhatsAppOtpProvider.java). All four required:
# a permanent access token, the business phone number's numeric ID (WhatsApp Manager ->
# API Setup, NOT the phone number itself), and a pre-approved "Authentication" category
# template name + language code (Meta rejects free-form text for OTP delivery).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Set both once to create the first SUPER_ADMIN on next boot (see AdminBootstrapRunner);
# no-ops if admin_users already has a row. Safe to blank out again afterward.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
