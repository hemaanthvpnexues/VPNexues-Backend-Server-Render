# Render Environment Variables — VPNexues backend
# Copy each KEY → Render Dashboard → Environment → "Add Environment Variable"
# Values marked FILL IN must come from your secret store — never commit them.

# ---------- required ----------
DB_URL=jdbc:postgresql://db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=FILL_IN_SUPABASE_DB_PASSWORD
JWT_SECRET=FILL_IN_random_48_bytes_base64

# Generate JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# ---------- CORS + cookies (production) ----------
CORS_ALLOWED_ORIGINS=https://tesing.vpnexues.com,http://tesing.vpnexues.com
COOKIE_SECURE=true

# ---------- OTP / Firebase ----------
OTP_PROVIDER=stub
FIREBASE_PROJECT_ID=vpnexues-otp-and-img-s

# ---------- Supabase (optional API helpers) ----------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=FILL_IN
SUPABASE_SECRET_KEY=FILL_IN
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ---------- SMTP (optional) =
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------- first admin (CLEAR after first successful boot) ----------
ADMIN_BOOTSTRAP_EMAIL=admin@vpnexues.com
ADMIN_BOOTSTRAP_PASSWORD=FILL_IN_STRONG_PASSWORD

# ---------- set by Render automatically (do not set yourself) ----------
# PORT=10000
